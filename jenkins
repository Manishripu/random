stage('Publish and Print Coverage') {
    agent any
    steps {
        script {
            // 1. Publish the visual reports to the Jenkins UI
            jacoco(
                execPattern: '**/target/*.exec',
                classPattern: '**/target/classes',
                sourcePattern: '**/src/main/java'
            )
            
            // 2. Extract and print the raw counts to the Console Output
            def xmlPath = 'target/site/jacoco/jacoco.xml'
            if (fileExists(xmlPath)) {
                def methodLine = sh(script: "grep '<counter type=\"METHOD\"' ${xmlPath}", returnStdout: true).trim()
                def missedMatcher = (methodLine =~ /missed="(\d+)"/)
                def coveredMatcher = (methodLine =~ /covered="(\d+)"/)
                
                if (missedMatcher.find() && coveredMatcher.find()) {
                    int missed = missedMatcher[0][1].toInteger()
                    int covered = coveredMatcher[0][1].toInteger()
                    
                    echo "--------------------------------------------------"
                    echo " PERFORMANCE METRICS (METHOD COUNTS)             "
                    echo "--------------------------------------------------"
                    echo " Covered Functions : ${covered}"
                    echo " Total Functions   : ${missed + covered}"
                    echo "--------------------------------------------------"
                }
            }
        }
    }
}

